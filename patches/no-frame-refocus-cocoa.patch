Subject: [PATCH] no-frame-refocus-cocoa (pinned Emacs 31 snapshot)

Adapted from d12frosted/homebrew-emacs-plus emacs-28 no-frame-refocus
patch. Rebased to a360712c9d272d950d8d8255ef74570f7e90b7d9.

Emacs 31 first attempts most-recently-used frame selection. Its fallback
path still calls ns_make_frame_key_window after choosing another visible
Cocoa frame. Remove only that forced key-window block; preserve MRU
selection and do_switch_frame. This retains the old patch's narrow intent,
not a guarantee about every macOS focus path.

diff --git a/src/frame.c b/src/frame.c
--- a/src/frame.c
+++ b/src/frame.c
@@ -2809,18 +2809,6 @@
 		      frame1 = Qnil;
 		    }
 		}
-#ifdef NS_IMPL_COCOA
-	      else
-		{
-		  /* Under NS, there is no system mechanism for choosing a new
-		     window to get focus -- it is left to application code.
-		     So the portion of THIS application interfacing with NS
-		     needs to make the frame we switch to the key window.  */
-		  struct frame *f1 = XFRAME (frame1);
-		  if (FRAME_NS_P (f1))
-		    ns_make_frame_key_window (f1);
-		}
-#endif
 	    }
 
 	  if (FRAMEP (frame1) && XFRAME (frame1) != f)
