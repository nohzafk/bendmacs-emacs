+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 140000
+  /* Redisplay clips the widget by sizing this container, and AppKit
+     does not clip a view's subviews to its bounds by default for
+     programs linked against macOS 14 or later.  */
+  if ([xv->xvWindow respondsToSelector:@selector (setClipsToBounds:)])
+    xv->xvWindow.clipsToBounds = YES;
+#endif
   xv->xvWindow.xw = xw;
   xv->xvWindow.xv = xv;
 
@@ -595,10 +614,21 @@ - (BOOL) isFlipped { return YES; }
   [xv->xvWindow release];
 }
 
+/* A native view is hidden with the 'hidden' property, so that AppKit
+   tells it through 'viewDidHide' and 'viewDidUnhide'.  A WebKit view is
+   moved out of sight instead, which WebKit is known to cope with.  */
+static bool
+nsxwidget_native_view_p (struct xwidget_view *xv)
+{
+  return XWIDGETP (xv->model) && EQ (XXWIDGET (xv->model)->type, Qnative);
+}
+
 void
 nsxwidget_show_view (struct xwidget_view *xv)
 {
   xv->hidden = NO;
+  if (xv->xvWindow.hidden)
+    xv->xvWindow.hidden = NO;
   [xv->xvWindow setFrameOrigin:NSMakePoint(xv->x + xv->clip_left,
                                            xv->y + xv->clip_top)];
 }
@@ -607,7 +637,10 @@ - (BOOL) isFlipped { return YES; }
 nsxwidget_hide_view (struct xwidget_view *xv)
 {
   xv->hidden = YES;
-  [xv->xvWindow setFrameOrigin:NSMakePoint(10000, 10000)];
+  if (nsxwidget_native_view_p (xv))
+    xv->xvWindow.hidden = YES;
+  else
+    [xv->xvWindow setFrameOrigin:NSMakePoint(10000, 10000)];
 }
 
 void
