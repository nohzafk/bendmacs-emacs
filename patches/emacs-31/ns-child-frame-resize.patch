+/* Step 2 of ns_child_frame_grow: apply the final window frame, resize the
+   view with it and draw, so that the new surface is committed in the
+   display frame in which the new area first shows.  */
+- (void)childGrowStep2
+{
+  NSWindow *window = [self window];
+
+  childGrowHold = NO;
+
+  if (window == nil || ! FRAME_LIVE_P (emacsframe))
+    return;
 
+  block_input ();
+  [window setFrame:childGrowFinalFrame display:NO];
+
+  NSRect frame = [[self superview] bounds];
+  [self setFrame:frame];
+  change_frame_size (emacsframe, (int)NSWidth (frame), (int)NSHeight (frame),
+                     false, YES, false);
   SET_FRAME_GARBAGED (emacsframe);
   cancel_mouse_face (emacsframe);
   ns_send_appdefined (-1);
+
+  if (!redisplaying_p)
+    {
+      bool owfi = waiting_for_input;
+      waiting_for_input = 0;
+      redisplay ();
+      waiting_for_input = owfi;
+    }
+  unblock_input ();
 }
 
+/* Drop a pending step 2 and the hold.  */
+- (void)cancelChildGrow
+{
+  [NSObject cancelPreviousPerformRequestsWithTarget:self
+                                           selector:@selector (childGrowStep2)
+                                             object:nil];
+  childGrowHold = NO;
+}
 
