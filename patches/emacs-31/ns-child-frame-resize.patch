+
+/* Child frame windows are non-opaque with a clear background, so that
+   the window area added by ns_child_frame_grow is invisible; other
+   windows keep the background color of their default face.  */
+static void
+ns_update_window_opacity (struct frame *f)
+{
+  NSWindow *window = [FRAME_NS_VIEW (f) window];
+  NSColor *col;
+
+  if (window == nil)
+    return;
+
+  if (FRAME_PARENT_FRAME (f))
+    {
+      [window setBackgroundColor:[NSColor clearColor]];
+      [window setOpaque:NO];
+    }
+  else
+    {
+      col = [NSColor colorWithUnsignedLong:NS_FACE_BACKGROUND
+                                     (FACE_FROM_ID (f, DEFAULT_FACE_ID))];
+      [window setBackgroundColor:col];
+      [window setOpaque:[col alphaComponent] == (EmacsCGFloat) 1.0];
+    }
+}
+
+/* Grow the window of child frame F to FRAME_RECT in two steps.
+
+   A chrome-less window (borderless, or titled with a full-size content
+   view) that grows through a single -setFrame: is presented, until a
+   later display frame, with the new area black: the commits that land in
+   the display frame of the shape change are clipped to the old size.
+   So the window is first extended to cover both the old and the new
+   size, while the EmacsView keeps its old frame and draws nothing, which
+   leaves the screen as it was.  A display frame later,
+   -[EmacsView childGrowStep2] applies the final frame and draws the new
+   surface.  The window is non-opaque with a clear background (see
+   ns_update_window_opacity), so the extension is invisible.
+
+   Return true if the grow was done in this way; the caller then must
+   not call -setFrame: itself.  Return false for every other resize.
+   Any pending step 2 is cancelled first.  */
+static bool
+ns_child_frame_grow (struct frame *f, EmacsView *view, NSWindow *window,
+                     NSRect frameRect)
+{
+  NSWindowStyleMask mask = [window styleMask];
+  NSRect cur, view_frame, step1;
+
+  [view cancelChildGrow];
+
+  if (!FRAME_PARENT_FRAME (f) || ![window isVisible]
+      || ((mask & NSWindowStyleMaskTitled)
+          && !(mask & NSWindowStyleMaskFullSizeContentView)))
+    return false;
+
+  view_frame = [view frame];
+  if (NSWidth (frameRect) <= NSWidth (view_frame)
+      && NSHeight (frameRect) <= NSHeight (view_frame))
+    return false;
+
+  cur = [window frame];
+  step1 = cur;
+  step1.size.width = MAX (NSWidth (cur), NSWidth (frameRect));
+  step1.size.height = MAX (NSHeight (cur), NSHeight (frameRect));
+
+  view->childGrowViewFrame = view_frame;
+  view->childGrowFinalFrame = frameRect;
+  view->childGrowHold = YES;
+  [window setFrame:step1 display:NO];
+  [view performSelector:@selector (childGrowStep2)
+             withObject:nil
+             afterDelay:0.02];
+  return true;
 }
 
